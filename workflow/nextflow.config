// STV_GSE137303 workflow configuration. Launch from the project root with the stv-rnaseq env active.
manifest {
    name = 'STV_GSE137303'
    description = 'Single-end RNA-seq QC and Salmon quantification for GSE137303'
    nextflowVersion = '>=26.04.0'
}

outputDir = 'results'
workflow.output.mode = 'copy'

// Conservative caps for a personal WSL2 machine (15 GiB RAM, 20 threads): leave CPU and RAM for the desktop.
executor {
    cpus = 12
    memory = 12.GB
}

process {
    cpus = 1
    memory = 1.GB
    resourceLimits = [cpus: 12, memory: 12.GB]
    errorStrategy = 'terminate'

    withLabel: 'process_single' {
        cpus = 1
        memory = 2.GB
    }
    withLabel: 'process_low' {
        cpus = 1
        memory = 1.GB
    }
    withLabel: 'process_medium' {
        cpus = 6
        memory = 6.GB
    }
    withLabel: 'process_high' {
        cpus = 8
        memory = 12.GB
    }

    withName: 'SALMON_INDEX' {
        // -k: see params.salmon_kmer. --ramLimit (GiB) caps sshash's external minimizer sort so the build fits
        // this 15 GiB machine; it trades RAM for disk spill only and does not change the index.
        ext.args = { "-k ${params.salmon_kmer} --ramLimit 6" }
    }
    withName: 'SALMON_QUANT' {
        // Single-end fragment-length distribution (see params.salmon_fld_mean / salmon_fld_sd).
        ext.args = { "--fldMean ${params.salmon_fld_mean} --fldSD ${params.salmon_fld_sd}" }
    }
}

report {
    enabled = true
    overwrite = true
    directory = 'pipeline_info'
}
timeline {
    enabled = true
    overwrite = true
    directory = 'pipeline_info'
}
trace {
    enabled = true
    overwrite = true
    directory = 'pipeline_info'
}

profiles {
    // Wiring test with synthetic fixtures (generate first: bash workflow/tests/stub/make_fixtures.sh):
    //   nextflow run workflow/main.nf -profile test_stub -stub -w work/stub -output-dir /tmp/stv_stub
    test_stub {
        params.input = 'workflow/tests/stub/samplesheet.csv'
        params.run_quant = true
        params.transcript_fasta = 'workflow/tests/stub/transcripts.fa'
        params.genome_fasta = 'workflow/tests/stub/genome.fa'
        params.multiqc_title = 'STUB TEST'
    }
}
